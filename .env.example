# ==============================================================================
# SPOTTING PRODUCTION CONFIGURATION
# ==============================================================================
# Copy to ".env" in the repo root on your Ubuntu server, edit values, then run:
#   sudo ./scripts/install-ubuntu.sh
# ==============================================================================

# --- Public URLs (must match your DNS + nginx + Let's Encrypt domains) ---
# Web dashboard (nginx → web container)
NEXT_PUBLIC_SITE_URL=https://spotting.yourdomain.com
NEXT_PUBLIC_APP_URL=https://spotting.yourdomain.com
# Hono API (nginx → api container; browser calls this directly)
NEXT_PUBLIC_SERVER_URL=https://api-spotting.yourdomain.com

# Comma-separated browser origins allowed by the API (usually your web URL)
CORS_ORIGINS=https://spotting.yourdomain.com

# Let's Encrypt contact email (used by install script)
CERTBOT_EMAIL=admin@yourdomain.com

# --- Local container ports (bound to 127.0.0.1; nginx terminates TLS) ---
WEB_PORT=3001
API_PORT=3000

# --- PostgreSQL ---
POSTGRES_DB=spotting
POSTGRES_USER=spotting_admin
POSTGRES_PASSWORD=change_me_to_a_long_random_password

# --- Auth ---
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=change_me_64_char_hex_secret_minimum_32_chars_required
BETTER_AUTH_URL=https://api-spotting.yourdomain.com

# --- AWS S3 (video / screenshot uploads) ---
S3_REGION=ap-south-1
S3_BUCKET=your-spotting-bucket
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# --- Email (AWS SES SMTP — create credentials in SES → SMTP settings) ---
SMTP_REGION=ap-south-1
SMTP_PORT=587
SMTP_USERNAME=AKIAxxxxxxxxxxxxxxxx
SMTP_PASSWORD=your_ses_smtp_password
SMTP_FROM=Spotting <noreply@yourdomain.com>
MAIL_APP_NAME=Spotting

# --- Worker ---
WORKER_INTERVAL_MS=30000

# --- Optional ---
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Path to built extension inside the web container (default: apps/extension/dist)
# SPOTTING_EXTENSION_DIST=/app/apps/extension/dist
