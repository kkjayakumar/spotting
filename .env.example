WEB_PORT=3001

API_PORT=3000

POSTGRES_PORT=5433

REDIS_PORT=6379

MINIO_PORT=9000

MINIO_CONSOLE_PORT=9001



POSTGRES_DB=spotting

POSTGRES_USER=postgres

POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/spotting?schema=public



REDIS_URL=redis://localhost:6379



# --- Object storage (S3-compatible) ---

# Local dev (MinIO via docker compose): use these defaults

S3_ENDPOINT=http://localhost:9000

S3_REGION=us-east-1

S3_ACCESS_KEY=minioadmin

S3_SECRET_KEY=minioadmin

S3_BUCKET=spotting-artifacts

# S3_AUTO_CREATE_BUCKET=true



# --- AWS S3 (staging/production) ---

# Omit S3_ENDPOINT (or leave empty) to use real AWS S3.

# Create the bucket in AWS first; do not rely on auto-create in prod.

# S3_REGION=us-east-1

# S3_BUCKET=your-spotting-artifacts-bucket

# AWS_ACCESS_KEY_ID=...

# AWS_SECRET_ACCESS_KEY=...

# Or omit keys and use IAM role on the host (ECS/EC2/Lambda).

# S3_AUTO_CREATE_BUCKET=false


