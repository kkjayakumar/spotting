# ==============================================================================
# SPOTTING CONFIGURATION — one `.env` for local Docker OR EC2 production
# ==============================================================================
# Copy to `.env`, pick ONE profile below, then run:
#   npm run docker:up
#
# Local Docker: use http://127.0.0.1 URLs (not https). Open:
#   http://127.0.0.1:3001  (web)   http://127.0.0.1:3000/healthz  (api)
#
# EC2 production (build on server):
#   sudo ./scripts/install-ubuntu.sh
#
# EC2 production (pull pre-built images from GHCR):
#   GHCR_IMAGE_PREFIX=ghcr.io/<github-owner>
#   SPOTTING_IMAGE_TAG=v1.0.0
#   sudo ./scripts/install-ubuntu-ghcr.sh
#   See docs/deployment/ec2-ghcr-hosting.md
# ==============================================================================

# --- LOCAL DOCKER (uncomment / use these values on your laptop) ---
# NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001
# NEXT_PUBLIC_APP_URL=http://127.0.0.1:3001
# NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:3000
# CORS_ORIGINS=http://127.0.0.1:3001
# SPOTTING_AUTH_URL=http://127.0.0.1:3000
# DOCKER_BIND_HOST=127.0.0.1

# --- EC2 PRODUCTION (public URLs — must match DNS + nginx) ---
# Web dashboard (nginx → web container)
NEXT_PUBLIC_SITE_URL=https://spotting.yourdomain.com
NEXT_PUBLIC_APP_URL=https://spotting.yourdomain.com
# Hono API (nginx → api container; browser calls this directly)
NEXT_PUBLIC_SERVER_URL=https://api-spotting.yourdomain.com

# Comma-separated browser origins allowed by the API (usually your web URL)
CORS_ORIGINS=https://spotting.yourdomain.com

# Let's Encrypt contact email (used by install script)
CERTBOT_EMAIL=admin@yourdomain.com

# --- Container ports (host binding; nginx on EC2 proxies to these) ---
DOCKER_BIND_HOST=127.0.0.1
WEB_PORT=3001
API_PORT=3000

# --- PostgreSQL ---
POSTGRES_DB=spotting
POSTGRES_USER=spotting_admin
POSTGRES_PASSWORD=change_me_to_a_long_random_password

# --- Local dev (docker compose infra) ---
POSTGRES_PORT=5433
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/spotting?schema=public

# --- Auth (Spotting session signing + public URL hints) ---
# Generate secret: openssl rand -hex 32
SPOTTING_AUTH_SECRET=change_me_64_char_hex_secret_minimum_32_chars_required
SPOTTING_AUTH_URL=https://api-spotting.yourdomain.com
# Optional cookie domain for future session cookies
# SPOTTING_AUTH_COOKIE_DOMAIN=.yourdomain.com
# Set false after running migrate:capture-keys (see docs/ops/capture-key-migration.md)
# npm run prelaunch runs migration and sets this automatically for local .env
SPOTTING_ACCEPT_LEGACY_CRK_KEYS=true

# --- Optional: private Crikket mirror for launch gate similarity scan ---
# CRIKKET_MIRROR_PATH=/path/to/private/crikket-checkout

# --- AWS S3 (video / screenshot uploads) ---
S3_REGION=ap-south-1
S3_BUCKET=your-spotting-bucket
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# --- Email (AWS SES SMTP — create credentials in SES → SMTP settings) ---
SMTP_REGION=ap-south-1
SMTP_PORT=587
SMTP_USERNAME=AKIAxxxxxxxxxxxxxxxx
SMTP_PASSWORD=your_ses_smtp_password
SMTP_FROM=Spotting <noreply@yourdomain.com>
MAIL_APP_NAME=Spotting

# --- Worker ---
WORKER_INTERVAL_MS=30000
# Delete reports older than this many days (default: 90)
REPORT_RETENTION_DAYS=90

# --- GHCR (EC2 pull-based deploy only; not needed for local docker:up) ---
# GHCR_IMAGE_PREFIX=ghcr.io/your-github-owner
# SPOTTING_IMAGE_TAG=v1.0.0

# --- Optional ---
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Path to built extension inside the web container (default: apps/extension/dist)
# SPOTTING_EXTENSION_DIST=/app/apps/extension/dist
