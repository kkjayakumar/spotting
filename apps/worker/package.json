{
  "name": "@spotting/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import tsx src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "profile": "node --import tsx src/profile.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@spotting/config": "*",
    "@prisma/client": "^6.6.0",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "vitest": "^3.2.4"
  }
}
