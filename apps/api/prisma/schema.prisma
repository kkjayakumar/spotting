generator client {
  provider = "prisma-client-js"
  /// Under `src/` so `tsc` rootDir stays valid; avoids Windows EPERM renaming the engine in `node_modules/.bun/...`.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  owner
  admin
  member
}

enum InviteRole {
  admin
  member
}

enum InvitationStatus {
  pending
  accepted
  rejected
  cancelled
}

enum ReportPriority {
  low
  medium
  high
  critical
}

enum ReportStatus {
  open
  in_progress
  resolved
  closed
}

enum ReportVisibility {
  private
  public
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String       @map("password_hash")
  name         String
  emailVerifiedAt DateTime? @map("email_verified_at")
  verificationSentAt DateTime? @map("verification_sent_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  sessions     Session[]
  memberships  Membership[]
  invitesSent  Invitation[] @relation("InvitationInviter")
  emailVerificationTokens EmailVerificationToken[]
  reportsAuthored Report[] @relation("ReportReporter")
}

model EmailVerificationToken {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  refreshTokenHash String   @unique @map("refresh_token_hash")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  createdAt         DateTime           @default(now()) @map("created_at")
  memberships       Membership[]
  invitations       Invitation[]
  reports           Report[]
  capturePublicKeys CapturePublicKey[]
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  userId         String         @map("user_id")
  role           MembershipRole
  createdAt      DateTime       @default(now()) @map("created_at")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  email          String
  role           InviteRole
  status         InvitationStatus @default(pending)
  expiresAt      DateTime?        @map("expires_at")
  inviterUserId  String?          @map("inviter_user_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviterUser    User?            @relation("InvitationInviter", fields: [inviterUserId], references: [id], onDelete: SetNull)
}

model CapturePublicKey {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  /// Full public token as issued to embeds (e.g. crk_live_…). Treat as secret in transit only over HTTPS.
  token          String       @unique
  label          String       @default("Embed")
  /// JSON array of allowed origins (strings). Empty array = allow any origin.
  allowedOrigins Json         @default("[]")
  revokedAt      DateTime?    @map("revoked_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("capture_public_keys")
}

model Report {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  /// Null when the report is submitted via embed / public capture key (end-user on a host site).
  reporterUserId String?          @map("reporter_user_id")
  title          String
  description    String?
  priority       ReportPriority   @default(medium)
  status         ReportStatus     @default(open)
  visibility     ReportVisibility @default(private)
  pageUrl        String?          @map("page_url")
  metadataJson   Json?            @map("metadata_json")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reporterUser   User?            @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  uploadSessions UploadSession[]
}

model UploadSession {
  id          String   @id @default(cuid())
  reportId    String   @map("report_id")
  uploadKey   String   @map("upload_key")
  contentType String   @map("content_type")
  expiresAt   DateTime @map("expires_at")
  finalizedAt DateTime? @map("finalized_at")
  createdAt   DateTime @default(now()) @map("created_at")
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
}
