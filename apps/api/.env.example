DATABASE_URL=postgresql://postgres:postgres@localhost:5433/spotting?schema=public

# AWS SES SMTP (create credentials in SES → SMTP settings)
SMTP_REGION=ap-south-1
SMTP_PORT=587
SMTP_USERNAME=AKIAxxxxxxxxxxxxxxxx
SMTP_PASSWORD=your-ses-smtp-password
SMTP_FROM=Spotting <noreply@yourdomain.com>

# Or SES API with IAM credentials (ses:SendRawEmail):
# AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
# AWS_SECRET_ACCESS_KEY=your-iam-secret-access-key
# SMTP_REGION=ap-south-1
# SMTP_FROM=Spotting <noreply@yourdomain.com>
