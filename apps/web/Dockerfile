FROM oven/bun:1.3.5-alpine

WORKDIR /app

ENV NODE_ENV=production
ARG NEXT_PUBLIC_SITE_URL=https://__SPOTTING_SITE_URL__
ARG NEXT_PUBLIC_APP_URL=https://__SPOTTING_APP_URL__
ARG NEXT_PUBLIC_SERVER_URL=https://__SPOTTING_SERVER_URL__
ARG NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
ARG NEXT_PUBLIC_CAPTURE_KEY=__SPOTTING_CAPTURE_KEY__
ARG NEXT_PUBLIC_DEMO_URL=https://__SPOTTING_DEMO_URL__
ARG NEXT_PUBLIC_POSTHOG_KEY=__SPOTTING_POSTHOG_KEY__
ARG NEXT_PUBLIC_POSTHOG_HOST=https://__SPOTTING_POSTHOG_HOST__
ARG SPOTTING_API_INTERNAL_URL=http://api:3000
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}
ENV NEXT_PUBLIC_SERVER_URL=${NEXT_PUBLIC_SERVER_URL}
ENV NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=${NEXT_PUBLIC_GOOGLE_AUTH_ENABLED}
ENV NEXT_PUBLIC_CAPTURE_KEY=${NEXT_PUBLIC_CAPTURE_KEY}
ENV NEXT_PUBLIC_DEMO_URL=${NEXT_PUBLIC_DEMO_URL}
ENV NEXT_PUBLIC_POSTHOG_KEY=${NEXT_PUBLIC_POSTHOG_KEY}
ENV NEXT_PUBLIC_POSTHOG_HOST=${NEXT_PUBLIC_POSTHOG_HOST}
ENV SPOTTING_API_INTERNAL_URL=${SPOTTING_API_INTERNAL_URL}

COPY package.json bun.lock turbo.json tsconfig.base.json ./
COPY patches ./patches
COPY apps ./apps
COPY packages ./packages

RUN bun install --frozen-lockfile
RUN bun run build:extension
RUN bun run build -- --filter=@spotting/web
RUN cp -R apps/web/.next apps/web/.next-template
RUN chmod +x apps/web/docker-entrypoint.sh

EXPOSE 3001

ENTRYPOINT ["./apps/web/docker-entrypoint.sh"]
CMD ["bun", "run", "--cwd", "apps/web", "start", "--", "--port", "3001", "--hostname", "0.0.0.0"]
