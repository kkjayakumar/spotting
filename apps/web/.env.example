NEXT_PUBLIC_SITE_URL=https://spotting.io
# Public URL of this Next app (may differ from API)
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Hono API — use root .env API_PORT (default 3000). Do not set these to the Next.js port.
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Server-only: Next proxies /v1/* here so widgets can use the web origin (e.g. :3003) and still hit Hono.
SPOTTING_API_INTERNAL_URL=http://127.0.0.1:3000
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# Posthog (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Spotting Capture SDK (optional)
NEXT_PUBLIC_SPOTTING_KEY=
