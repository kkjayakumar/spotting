{
  "name": "@spotting/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-target.mjs chrome",
    "build:chrome": "node scripts/build-target.mjs chrome",
    "build:firefox": "node scripts/build-target.mjs firefox",
    "build:safari": "node scripts/build-target.mjs safari",
    "package:chrome": "node scripts/package-target.mjs chrome",
    "package:firefox": "node scripts/package-target.mjs firefox",
    "package:safari": "node scripts/package-target.mjs safari",
    "package:all": "npm run package:chrome && npm run package:firefox && npm run package:safari",
    "safari:convert": "bash scripts/safari-convert.sh",
    "dev": "vite build && node scripts/verify-dist.mjs chrome && vite build --watch",
    "check-types": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@spotting/sdk-js": "*",
    "@spotting/shared": "*"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "jszip": "^3.10.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.3"
  }
}
