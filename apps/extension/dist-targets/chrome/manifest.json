{
  "manifest_version": 3,
  "name": "Spotting Capture",
  "version": "0.1.0",
  "description": "Inject the Spotting bug reporter on any site (QA / third-party testing).",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "tabCapture"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Spotting",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
