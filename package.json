{
  "name": "spotting",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@spotting/api",
    "dev:web": "turbo run dev --filter=@spotting/web",
    "dev:worker": "turbo run dev --filter=@spotting/worker",
    "build:sdk": "turbo run build --filter=@spotting/sdk-js",
    "build:extension": "turbo run build --filter=@spotting/sdk-js --filter=@spotting/extension",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "verify": "bun run lint && bun run check-types && bun run test && bun run build",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml --env-file .env up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml --env-file .env down",
    "db:generate": "bun run --filter=@spotting/api prisma:generate",
    "db:push": "bun run --filter=@spotting/api db:push",
    "demo:setup": "bun run infra:up && bun run db:generate && bun run db:push",
    "demo:start": "bun run dev",
    "profile:api": "bun run scripts/profile-api.ts",
    "profile:worker": "bun run --filter=@spotting/worker profile"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3"
  },
  "patchedDependencies": {
    "next-themes@0.4.6": "patches/next-themes@0.4.6.patch"
  }
}
